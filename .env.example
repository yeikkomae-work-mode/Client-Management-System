# Client-Management-System — GitHub sync config
# Copy to .env and edit.  .env is gitignored; .env.example is committed.

# ── Remote ───────────────────────────────────────────────────────
GIT_REMOTE=origin
GIT_REMOTE_URL=git@github.com:yeikkomae-work-mode/Client-Management-System.git
GIT_BRANCH=main

# ── Commit identity (blank = use your global git config) ─────────
# Not GIT_AUTHOR_* on purpose: git reads those itself and empty would break it.
SYNC_AUTHOR_NAME=
SYNC_AUTHOR_EMAIL=

# ── Commit message ───────────────────────────────────────────────
# Final message is: "<COMMIT_PREFIX>: <date>" unless you pass -m "..."
COMMIT_PREFIX=Sync

# ── Safety guards ────────────────────────────────────────────────
# Refuse to push if the GitHub repo is PUBLIC. This folder holds client
# profiles, meeting notes, lead lists and prospect PII. Leave as true.
REQUIRE_PRIVATE_REPO=true

# Abort the push if the pre-flight scan finds a credential-shaped string
# or a known-sensitive filename in the staged changes. Leave as true.
SCAN_FOR_SECRETS=true

# Ask for y/N confirmation before pushing.
CONFIRM_BEFORE_PUSH=true

# ── AdsPower (Penji — LinkedIn persona profiles) ─────────────────
# Used by .mcp.json (adspower-local-api server) and the adspower-browser
# CLI/skill installed under .agents/skills/adspower-browser.
#
# ⚠️ Claude Code does NOT read this .env file when expanding ${VAR} in
# .mcp.json — it reads your SHELL environment. Putting the key here alone
# will not start the server. Export it in ~/.zshrc as well:
#     export ADSPOWER_API_KEY="...."   # for .mcp.json
#     export ADS_API_KEY="$ADSPOWER_API_KEY"   # for the `ads` CLI
#
# The live key belongs in RESOURCES/Tools & API Details/tools_api_details.md
# (gitignored), not in any committed file.
ADSPOWER_API_KEY=
ADS_API_KEY=

# ── Gojiberry (Penji — lead enrichment + LinkedIn outreach) ──────
# Used by .mcp.json (gojiberry server) as: Authorization: Bearer ${GOJIBERRY_API_KEY}
# Same caveat as above — export it in your shell, not just here:
#     export GOJIBERRY_API_KEY="eyJ...."
#
# ⚠️ The issued key is an ORG-level credential (business@penji.co), not a
# personal one, and it exposes write/send tools — including
# impersonate_user and send_unibox_linkedin_message (delivers real
# LinkedIn messages to real people). Treat it as production access.
# Store the live value in RESOURCES/Tools & API Details/tools_api_details.md
# (gitignored), never in a committed file.
GOJIBERRY_API_KEY=
