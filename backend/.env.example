# Agent Tracking System Configuration

# Server port (default: 3001)
PORT=3001

# Cowork directory (absolute path to Client-Management-System)
# This is auto-detected, but can be overridden
COWORK_DIR=/Users/eikkoyu/Claude Code:Cowork/Client-Management-System

# Database location (relative to backend directory)
# Default: agent-tracking.db
DB_PATH=agent-tracking.db

# File watcher settings
WATCH_POLL_INTERVAL=5000
WATCH_STABILIZATION_MS=2000

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# Enable detailed file monitoring logs
DEBUG_FILE_WATCH=false

# --- Campaigns & Projects dashboard: live sync API keys ---
# All optional — a source without a key just shows "not connected" in the
# dashboard instead of failing the sync. Never commit real keys; this file
# is the template, backend/.env (gitignored) holds the real values.

# Smartlead — Albert Scott (Yoni) workspace
SMARTLEAD_ALBERTSCOTT_API_KEY=

# PlusVibe — Satlas workspace (Chris Drew)
PLUSVIBE_SATLAS_API_KEY=
PLUSVIBE_SATLAS_BASE_URL=

# PlusVibe — Sellervate workspace (Cüneyt / Starfix)
PLUSVIBE_SELLERVATE_API_KEY=
PLUSVIBE_SELLERVATE_BASE_URL=

# Zapmail — domains & mailboxes (Satlas)
ZAPMAIL_API_KEY=
