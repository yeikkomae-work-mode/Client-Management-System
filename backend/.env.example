# Agent Tracking System Configuration

# Server port (default: 3001)
PORT=3001

# Cowork directory (absolute path to Client-Management-System)
# This is auto-detected, but can be overridden
COWORK_DIR=/Users/eikkoyu/Claude Code:Cowork/Client-Management-System

# Database location (relative to backend directory)
# Default: agent-tracking.db
DB_PATH=agent-tracking.db

# File watcher settings
WATCH_POLL_INTERVAL=5000
WATCH_STABILIZATION_MS=2000

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# Enable detailed file monitoring logs
DEBUG_FILE_WATCH=false
